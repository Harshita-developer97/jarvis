# GEMINI_API_KEY: Optional cloud AI fallback for Gemini API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Local Ollama inference server URL (default http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# LLAMACPP_BASE_URL: Optional local llama.cpp OpenAI-compatible server URL
LLAMACPP_BASE_URL="http://127.0.0.1:8080"

# JARVIS_WORKSPACE_ROOT: Authorized workspace directory for file/code tools (defaults to current project root)
JARVIS_WORKSPACE_ROOT=""

# JARVIS_PASSCODE: Optional owner passcode for high-risk approvals & device pairing
JARVIS_PASSCODE=""
